{
  "name": "silocore-backend",
  "version": "1.0.0",
  "description": "Backend service for SiloCore - Node.js, Express, TypeScript, Prisma, and Docker.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "dev:worker": "ts-node src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src --ext .ts",
    "test": "jest --runInBand --detectOpenHandles",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.ts --runInBand --detectOpenHandles",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "pgboss:plans": "pg-boss plans migrate --schema ${PGBOSS_SCHEMA:-pgboss}",
    "pgboss:migrate": "pg-boss migrate --schema ${PGBOSS_SCHEMA:-pgboss}",
    "pgboss:version": "pg-boss version --schema ${PGBOSS_SCHEMA:-pgboss}",
    "pgboss:doctor": "pg-boss doctor --schema ${PGBOSS_SCHEMA:-pgboss}"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "ollama",
    "docker",
    "api"
  ],
  "author": "Antony Sebastian",
  "license": "Apache-2.0",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.0",
    "pg-boss": "^12.27.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.2",
    "piscina": "^5.3.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jiti": "^2.6.1",
    "nodemon": "^3.1.3",
    "prisma": "^5.20.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
