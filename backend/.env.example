# Backend environment variables
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/silocore
INTEGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/silocore_integration_test
JWT_SECRET=your_jwt_secret_here

# Ollama
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=your_ollama_model
EMBEDDING_MODEL=your_embedding_model

# Worker / pg-boss
WORKER_CONCURRENCY=1
PISCINA_THREAD_COUNT=1
WORKER_SHUTDOWN_GRACE_MS=30000
WORKER_JOB_HEARTBEAT_INTERVAL_MS=10000
PGBOSS_SCHEMA=pgboss
