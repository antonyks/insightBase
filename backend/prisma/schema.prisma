generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id           Int     @id @default(autoincrement())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  status       UserStatus @default(ACTIVE)
  chatSessions         ChatSession[]
  ownedWorkspaces      Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMembership[]
  createdJobs          Job[]                 @relation("JobCreator")
  @@map("users")
}

model ChatSession {
  id           Int     @id @default(autoincrement())
  title        String
  userId       Int
  workspaceId  Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     ChatMessage[]
  @@index([workspaceId])
  @@map("chat_sessions")
}

model ChatMessage {
  id           Int     @id @default(autoincrement())
  content      String  @db.Text
  author       MessageAuthor @default(USER)    // 'user' or 'assistant'
  metadata     Json?         @default("{}")
  sessionId    Int
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

model LlmProviderConfig {
  id           Int      @id @default(autoincrement())
  name         String
  type         LlmProviderConfigType
  baseUrl      String
  enabled      Boolean  @default(true)
  defaultModel String
  timeoutMs    Int?
  generationDefaults Json    @default("{}")
  extraHeaders Json?    @default("{}")
  apiKey       String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  generationUsages GenerationUsage[]

  @@index([enabled])
  @@index([deletedAt])
  @@map("llm_provider_configs")
}

model Workspace {
  id          Int                   @id @default(autoincrement())
  name        String
  type        WorkspaceType
  status      WorkspaceStatus       @default(ACTIVE)
  ownerUserId Int
  owner       User                  @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  memberships WorkspaceMembership[]
  chatSessions ChatSession[]
  jobs         Job[]
  generationUsages GenerationUsage[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([ownerUserId])
  @@index([type])
  @@index([status])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          Int                       @id @default(autoincrement())
  workspaceId Int
  userId      Int
  role        WorkspaceMembershipRole
  status      WorkspaceMembershipStatus @default(ACTIVE)
  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@map("workspace_memberships")
}

model Job {
  id                 Int       @id @default(autoincrement())
  workspaceId        Int
  type               String
  status             JobStatus @default(QUEUED)
  progress           Int       @default(0)
  stage              String    @default("queued")
  payload            Json      @default("{}")
  result             Json?
  errorCode          String?
  sanitizedError     String?   @db.Text
  attempts           Int       @default(0)
  maxAttempts        Int       @default(1)
  queueMessageId     String?
  createdByUserId    Int
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdByUser      User      @relation("JobCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt          DateTime  @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  heartbeatAt        DateTime?
  cancelRequestedAt  DateTime?

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([status])
  @@index([createdByUserId])
  @@unique([queueMessageId])
  @@map("jobs")
}

model GenerationUsage {
  id               Int                             @id @default(autoincrement())
  workspaceId      Int
  providerId       Int
  model            String
  streaming        Boolean
  latencyMs        Int?
  inputTokens      Int?
  outputTokens     Int?
  totalTokens      Int?
  tokenCountSource GenerationUsageTokenCountSource @default(UNKNOWN)
  outcome          GenerationUsageOutcome
  errorCode        String?
  workspace        Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  provider         LlmProviderConfig               @relation(fields: [providerId], references: [id], onDelete: Restrict)
  createdAt        DateTime                        @default(now())

  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@index([providerId, createdAt])
  @@index([outcome, createdAt])
  @@map("generation_usages")
}

enum LlmProviderConfigType {
  OLLAMA
  OPENAI_COMPATIBLE
}

enum MessageAuthor {
  USER
  ASSISTANT
  SYSTEM
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DELETED
  BANNED
}

enum WorkspaceType {
  PERSONAL
  STANDARD
}

enum WorkspaceStatus {
  ACTIVE
  DELETED
}

enum WorkspaceMembershipRole {
  OWNER
  EDITOR
  VIEWER
}

enum WorkspaceMembershipStatus {
  ACTIVE
  INACTIVE
}

enum JobStatus {
  QUEUED
  RUNNING
  CANCEL_REQUESTED
  CANCELLED
  SUCCEEDED
  FAILED
}

enum GenerationUsageOutcome {
  SUCCEEDED
  FAILED
  ABORTED
}

enum GenerationUsageTokenCountSource {
  PROVIDER_REPORTED
  ESTIMATED
  UNKNOWN
}
